/storage/**/*.pdf
/storage/**/*.png
/storage/**/*.jpg
/storage/**/*.jpeg

# Production
/build
/dist

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Prisma
# Keep schema and migrations, ignore sqlite if any
*.db
*.db-journal

# OS files
.DS_Store
*.pem
Thumbs.db

# IDEs
.vscode/
.idea/
