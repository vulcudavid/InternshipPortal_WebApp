# ==============================================================================
# Configurare Bază de Date PostgreSQL (Docker / Mediu Local)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=web2_lab
POSTGRES_PORT=5432

# URL de conectare Prisma ORM
# - Local (Docker Compose): postgresql://postgres:postgrespassword@localhost:5432/web2_lab?schema=public
# - Producție (Railway): este injectat automat de plugin-ul PostgreSQL din Railway
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/web2_lab?schema=public"

# ==============================================================================
# Configurare Aplicație & Domeniu
# ==============================================================================
# URL-ul de bază al aplicației (folosit pentru generarea linkurilor absolute și redirecționări)
# - Local: http://localhost:3000
# - Producție (Railway): https://nume-proiect.up.railway.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Activare / Dezactivare autentificare rapidă demo (selector de roluri / conturi demo)
# - Local / Testare: "true" (permite comutarea rapidă între roluri și popularea cu date demo)
# - Producție (Railway): "false" (blochează login-ul demo și omite datele mock la seed pentru securitate)
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="true"

# ==============================================================================
# Stocare Fișiere (CV-uri încărcate și Convenții de practică PDF generate)
# ==============================================================================
# Calea către directorul unde se persistă fișierele
# - Local: "./storage" (sau lăsat necompletat pentru a folosi directorul storage/ din rădăcina proiectului)
# - Producție (Railway): "/storage" (asociat cu un Railway Persistent Volume montat la /storage)
STORAGE_PATH="./storage"

# ==============================================================================
# Parole Inițiale pentru Populare Bază de Date (Seed)
# ==============================================================================
# Parola pentru contul de administrator universitar (admin@universitate.ro)
ADMIN_SEED_PASSWORD="AdminULBS2026!"

# Parola pentru contul de coordonator universitar de practică (coordonator@universitate.ro)
COORDINATOR_SEED_PASSWORD="CoordULBS2026!"

# ==============================================================================
# Serviciu de Email SMTP (Verificare OTP Email Studenți @ulbsibiu.ro)
# ==============================================================================
# Dacă SMTP_HOST este lăsat gol, codul OTP de 6 cifre este afișat în consola serverului: [MAILER FALLBACK] Code for <email>: <code>
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"Portal Practică ULBS" <no-reply@ulbsibiu.ro>'

# Cheie secretă pentru semnarea criptografică a cookie-urilor de sesiune
AUTH_SECRET="cheie-secreta-locala-de-dezvoltare-ulbs-2026"
